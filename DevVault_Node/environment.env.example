# Copy to environment.env for local development. In production set these in the host's dashboard.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devvault?retryWrites=true&w=majority
# Production: at least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string
# Exact frontend origin, no trailing slash
CLIENT_URL=http://localhost:4200
# Set to "production" on the host
NODE_ENV=development
